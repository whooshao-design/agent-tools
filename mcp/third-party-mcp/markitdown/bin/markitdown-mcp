#!/usr/bin/env bash
set -euo pipefail

# 0.0.1a4 的 --http 不可用：它构造了 StreamableHTTPSessionManager 却没进入
# run() 生命周期，每个请求都以 "Task group is not initialized" 500 失败。
PACKAGE="${MARKITDOWN_MCP_PACKAGE:-markitdown-mcp==0.0.1a7}"
CACHE_ROOT="${AGENT_TOOLS_MCP_CACHE:-/tmp/agent-tools-mcp-cache}"
VENV="${MARKITDOWN_MCP_VENV:-$CACHE_ROOT/markitdown-mcp-venv}"
PYTHON_BIN="${PYTHON:-python3}"
export PIP_DISABLE_PIP_VERSION_CHECK="${PIP_DISABLE_PIP_VERSION_CHECK:-1}"

if [ -n "${MARKITDOWN_MCP_BIN:-}" ]; then
  exec "$MARKITDOWN_MCP_BIN" "$@"
fi

if command -v markitdown-mcp >/dev/null 2>&1; then
  exec markitdown-mcp "$@"
fi

if [ ! -x "$VENV/bin/markitdown-mcp" ]; then
  echo "Installing $PACKAGE into $VENV" >&2
  "$PYTHON_BIN" -m venv "$VENV"
  PIP_CACHE_DIR="${PIP_CACHE_DIR:-$CACHE_ROOT/pip}" "$VENV/bin/python" -m pip install "$PACKAGE" >&2
fi

exec "$VENV/bin/markitdown-mcp" "$@"
