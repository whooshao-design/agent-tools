#!/usr/bin/env bash
set -euo pipefail

PACKAGE="${CONTEXT7_MCP_PACKAGE:-@upstash/context7-mcp@3.1.0}"
CACHE_ROOT="${AGENT_TOOLS_MCP_CACHE:-/tmp/agent-tools-mcp-cache}"
export NPM_CONFIG_CACHE="${NPM_CONFIG_CACHE:-$CACHE_ROOT/npm}"
export NPM_CONFIG_UPDATE_NOTIFIER="${NPM_CONFIG_UPDATE_NOTIFIER:-false}"

args=(-y "$PACKAGE")
if [ -n "${CONTEXT7_API_KEY:-}" ]; then
  args+=(--api-key "$CONTEXT7_API_KEY")
fi

exec npx "${args[@]}" "$@"
