# devtools MCP 本地配置（CHG-014）
#
# 用法：cp mcp/devtools-mcp/.env.example mcp/devtools-mcp/.env，按需填写。
# devtools_mcp.common.env_value() 先读进程环境，再读本文件（DEVTOOLS_MCP_ENV 可改路径）。
# 任意键留空（KEY=）等同未设置，取各 server 的代码默认值；不能用空值关闭默认白名单。
# install.py --with-mcp 生成的注册项只保留 PYTHONPATH 与 BASTION_CONFIG，下面 7 个“允许域名 / 基地址”
# 原先写在注册项 env 里，迁到本文件；留空则用各 server 的默认域名。

# ── 允许访问的内网域名（逗号分隔），原注册项里的 7 个键 ──
ARTIFACT_REPO_ALLOWED_HOSTS=
CONFIG_REGISTRY_ALLOWED_HOSTS=
MQ_ALLOWED_HOSTS=
OBSERVABILITY_ALLOWED_HOSTS=
GITLAB_BASE_URL=
JENKINS_BASE_URL=
SONARQUBE_BASE_URL=

# ── internal_http_request 放行的域名（逗号分隔），留空用默认公司内网域名 ──
INTERNAL_HTTP_ALLOWED_HOSTS=

# ── GitLab 凭证（任填一种；留空走浏览器登录态） ──
GITLAB_TOKEN=
GITLAB_PRIVATE_TOKEN=
GITLAB_BEARER_TOKEN=

# ── Jenkins 凭证（留空走浏览器登录态） ──
JENKINS_USER=
JENKINS_API_TOKEN=
JENKINS_TOKEN=
JENKINS_COOKIE=

# ── SonarQube 凭证（留空走浏览器登录态） ──
SONARQUBE_COOKIE=
SONARQUBE_XSRF_TOKEN=
