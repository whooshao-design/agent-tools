# agent-tools 本机配置变量（CHG-002）
#
# 用法：
#   cp env/local.env.example env/local.env
#   按需填写；没填的键用默认值。改完重跑 python3 install.py --with-global 让客户端配置与渲染副本同步。
#
# install.py 只接受下面四个键（具名白名单），其他键忽略并在 stderr 列出。
# 仓库根 AGENT_TOOLS_ROOT 由 install.py 从自身位置推导，不要写在这里。
# 三个路径键允许以 ~ 开头，install.py 写进客户端配置前会展开成绝对路径。
# 文件语法与 credentials.env 相同：每行 KEY=VALUE，# 开头与空行跳过，不处理引号。

# 文档产物根，默认 ~/docs
AGENT_TOOLS_DOCS_ROOT=

# 代码工作区根，默认 ~/projects
AGENT_TOOLS_WORKSPACE_ROOT=

# Playwright 工具目录，默认 ~/.local/share/agent-tools/browser-tool；
# 默认目录无效而旧目录 ~/tools/lexiao-browser 有效时自动改用旧目录
BROWSER_SESSION_TOOL_DIR=

# 打开 URL / 文件 / 图片的命令模板，空格分词，{target} 占一个词（不写则目标追加为最后一个词）。
# 留空按平台取默认：darwin `open {target}`，linux `xdg-open {target}`，wsl 走 powershell.exe Start-Process
AGENT_TOOLS_OPEN_CMD=
