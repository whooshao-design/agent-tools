# agent-tools 公共凭证配置
#
# 用法：
#   cp env/credentials.env.example env/credentials.env
#   chmod 600 env/credentials.env
#   按需填写；用不到的整段留空即可。
#
# env/ 已整目录 gitignore，只有 *.example 与 .gitkeep 入库，真实凭证不会被提交。
#
# ── 重要前提 ────────────────────────────────────────────────────────────
# 本仓库多数 skill 的默认认证方式是**复用浏览器登录态**（见 get-browser-session），
# 下面绝大多数变量都是**可选覆盖**，不填也能正常工作。只有明确标注【必填】的，
# 才是没有它就用不了的能力。
# ───────────────────────────────────────────────────────────────────────


# ══ 飞书 / Lark 开放平台 ══════════════════════════════════════════════
# 【必填】才能使用飞书文档读写（这是唯一无法靠浏览器登录态实现的能力：
# 组织安全策略禁止 Linux 客户端登录飞书，只能走开放平台 API）。
# 取值：open.feishu.cn → 开发者后台 → 你的应用 → 凭证与基础信息
LARK_APP_ID=
LARK_APP_SECRET=

# 国内版保持默认；Lark 国际版改为 https://open.larksuite.com
LARK_DOMAIN=https://open.feishu.cn

# OAuth 本地回调端口。必须与控制台「安全设置 → 重定向 URL」登记的
# http://localhost:<端口>/callback 完全一致。
LARK_OAUTH_PORT=3000

# OAuth 申请的权限范围，空格分隔。
# 必须显式指定：实测不传 --scope 时飞书只会授予 auth:user.id:read，
# 授权页会显示“可授予的权限（共 1 项）”，读不了任何文档。
# 这里列的每一项都必须已在控制台开通、并随版本发布，否则整个授权会被拒绝。
LARK_SCOPE=docx:document:readonly wiki:wiki:readonly

# 可选：加载哪些工具集。可用预设 preset.doc.default / preset.im.default /
# preset.base.default / preset.calendar.default / preset.task.default，逗号分隔。
LARK_TOOLS=preset.doc.default
# 可选：user_access_token（本人身份，可读本人有权限的所有文档）
#       tenant_access_token（应用身份，只能读显式授权给应用的文档）
LARK_TOKEN_MODE=user_access_token
LARK_LANGUAGE=zh


# ══ 乐信云 lxcloud ════════════════════════════════════════════════════
# 用于线上 MySQL 查询等（query-mysql-data）。留空则自动复用浏览器登录态。
LXCLOUD_BEARER_TOKEN=
LXCLOUD_AUTHORIZATION=
LXCLOUD_COOKIE=
LXCLOUD_MID=
LXCLOUD_USER_NAME=
# 可选：请求超时毫秒数；设为 1 可禁用浏览器登录态回退（调试用）
LXCLOUD_TIMEOUT_MS=
LXCLOUD_DISABLE_BROWSER_SESSION=


# ══ 雷神 / Healthy 监控 ═══════════════════════════════════════════════
# 指标注册与查询（register-healthy-metrics / inspect-healthy-metrics）。
# 留空则复用浏览器登录态。
HEALTHY_METRIC_TOKEN=


# ══ 扁鹊 bianque 服务模拟器 ═══════════════════════════════════════════
# Dubbo 调用与 stable 审批处理（test-dubbo-api / handle-stable-hawk-approval）。
# 留空则复用浏览器登录态。
BIANQUE_COOKIE=


# ══ 堡垒机 bastion ════════════════════════════════════════════════════
# 注意：堡垒机的主机清单仍在 mcp/bastion-mcp/config.json（已 gitignore），
# 这里只放密码与开关，不重复维护主机列表。
BASTION_PASSWORD=
# 使用哪个 profile（对应 config.json 里的条目名）
BASTION_PROFILE=
# 自定义配置文件路径；留空用默认 mcp/bastion-mcp/config.json
BASTION_CONFIG=
# 置为 1 才允许写操作，默认只读
BASTION_ALLOW_WRITE=


# ══ 浏览器会话（get-browser-session 及其复用方）═══════════════════════
# 都有合理默认值，一般不用改。
# 共享 profile 目录，默认 ~/.cache/lexiao-browser-profile
BROWSER_SESSION_PROFILE=
# Playwright/Chromium 工具目录，默认 ~/tools/lexiao-browser
BROWSER_SESSION_TOOL_DIR=
DEVTOOLS_BROWSER_PROFILE=


# ══ 其它本地路径 ══════════════════════════════════════════════════════
# mysql 客户端路径，默认从 PATH 查找
MYSQL_BIN=
# Dubbo 目标机器清单，默认 skills/lexin/test-dubbo-api/targets.json
DUBBO_TARGETS_FILE=
